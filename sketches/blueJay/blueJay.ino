void setup() {
  FastLED.addLeds<WS2812B, PIN_ROW1, GRB>(leds1, NUM_LEDS_PER_STRIP);
  FastLED.addLeds<WS2812B, PIN_ROW2, GRB>(leds2, NUM_LEDS_PER_STRIP);
  FastLED.addLeds<WS2812B, PIN_ROW3, GRB>(leds3, NUM_LEDS_PER_STRIP);

  FastLED.setBrightness(30);

  for (int y = 0; y < HEIGHT; y++) {
    int strip = y / ROWS_PER_STRIP;
    int localRow = y % ROWS_PER_STRIP;
    for (int x = 0; x < WIDTH; x++) {
      int col = (SERPENTINE && (localRow % 2)) ? (WIDTH - 1 - x) : x;
      strips[strip][localRow * WIDTH + col] = CRGB(blueJay[y][x]);
    }
  }

  FastLED.show();
}

void loop() {
  // Nothing changes.
}
